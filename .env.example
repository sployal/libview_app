# Server
PORT=3000

# Comma-separated browser origins allowed to call this API.
# The Flutter app does not send Origin and is still allowed.
# Other websites are rejected. Use * only for local debugging.
ALLOWED_ORIGINS=https://edupal-web.vercel.app

# Google OAuth client used for Drive access. Create a Web application OAuth
# client in Google Cloud Console and add the callback URL as a redirect URI.
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google account whose Drive this server is allowed to use. /auth/google
# only saves a token if the signed-in account matches this email. A different
# Google login would point uploads at a different Drive, so mismatches are rejected.
GOOGLE_DRIVE_EMAIL=your_drive_account@example.com

# Optional secret protecting the one-time /auth/google setup route.
AUTH_SETUP_SECRET=change_this_setup_secret

# Optional Drive folder ID. If omitted, the server resolves the Edupal folder
# by walking up from the first configured semester folder.
ROOT_FOLDER_ID=

# Path to the Firebase Admin SDK service account JSON, used to verify
# the ID tokens your Flutter app sends. Download from:
# Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SA_KEY_PATH=./secrets/firebase-service-account.json

# Optional: comma-separated Firebase UIDs allowed to delete files/folders.
# Leave empty to allow any signed-in user to delete (not recommended for production)
# Max upload size in bytes (default 20MB)
MAX_UPLOAD_BYTES=20971520

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_AI_MODEL=meta/llama-3.2-90b-vision-instruct

# Email that is automatically granted the system_admin Firestore role.
# No hardcoded admin email — set this to the account that should manage the app.
# ADMIN_UIDS can also grant access.
SYSTEM_ADMIN_EMAIL=your_admin_email@example.com

# Landing-page inquiries are forwarded here. Falls back to SYSTEM_ADMIN_EMAIL
# if unset. Mail is sent with the Gmail API using the same Google OAuth as Drive.
# After deploying, visit /auth/google once so the token includes gmail.send.
CONTACT_EMAIL=your_inbox@example.com


CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# Public Drive API keys (same split as the Flutter app).
# GOOGLE_DRIVE_API_KEY — list/read folder contents and thumbnails.
# GOOGLE_DRIVE_DOWNLOAD_API_KEY — file metadata + media download.
# Create, upload, rename, and delete still use Google OAuth above.
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_DOWNLOAD_API_KEY=